# Optional: override canonical URL for staging or custom domain (no trailing slash)
# VITE_SITE_URL=https://elite-mob.github.io

# EmailJS (contact form). Required together for "Send message" to work. Get values from https://www.emailjs.com/
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# Optional: if your template maps a variable (e.g. to_email)
# VITE_EMAILJS_TO_EMAIL=
# Optional: shown in error toasts only (fallback contact)
# VITE_CONTACT_EMAIL=

# Firebase (Analytics + Firestore footer visit stats; leave unset to disable)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
